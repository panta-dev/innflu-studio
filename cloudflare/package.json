{
  "name": "innflu-cloudflare",
  "version": "1.0.0",
  "description": "Innflu - Cloudflare Workers API and Web Dashboard for Influencer Automation",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute innflu-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute innflu-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
