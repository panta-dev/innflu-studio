{
  "manifest_version": 3,
  "name": "Innflu - Smart Instagram Prospector",
  "version": "1.3.3",
  "description": "Automação e prospecção de influenciadores no Instagram com mineração de WhatsApp/Email, captação por templates e automação com delays anti-ban.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://*.workers.dev/*",
    "https://*.pages.dev/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "css": ["styles/overlay.css"],
      "js": [
        "lib/spintax.js",
        "lib/gender-heuristics.js",
        "lib/contact-extractor.js",
        "content/inspector.js",
        "content/crawler.js",
        "content/sender.js",
        "content/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Innflu - Controle de Prospecção"
  }
}
